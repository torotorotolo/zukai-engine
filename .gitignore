# ══ 2本目：日本航空123便（62-2 JA8119）══════════════════════
# 🔴 **題材ごとのフォルダに切り替えた**（1枚ずつ許可を足すのは、写真を差し替えるたびに
#    書き忘れが起きるため。r24 は 40分焼いた最後に FileNotFoundError で落ちた）。
# 中身は運輸安全委員会の事故調査報告書から機械的に切り出した 168 枚
#   p001〜p124 … 写真‐1〜124 ／ f001〜f038 … 付図‐1〜38
#   a1p001,002 … 別添1 写真‐1,2 ／ a1f001〜004 … 別添1 付図‐1〜4
# 取り出しは `python tools/extract_photos.py`（出どころと根拠は ref/CREDITS.md）。
# 権利は **公共データ利用規約 PDL1.0**（CC BY 4.0 互換。複製・公衆送信・翻案を許諾）。
!ref/ja123/

# ══ 3本目：スレッシャー号（USS Thresher SSN-593 / 1963-04-10）══════════
# 中身は3つ。出どころと根拠は ref/CREDITS.md の台帳と1対1。
#   thr_t1〜t41.jpg … NARA 289-T アルバム41ページから写真部分を切り出したもの
#   thr_fig*.png    … 査問会記録 第9・10次公開から取り出した海図・データ表
#   thr_cm_*.jpg    … Wikimedia Commons の PD 写真（CC BY-SA は入れない＝継承を避ける）
# 権利＝米海軍の職務著作でパブリックドメイン（NARA "Works of the U.S. Government"）
!ref/thresher/
# 🔴 原本（アルバム5860px×41点＝350MB）と査問会PDF（128MB）は**入れない**。
#    このリポジトリは public で、git は履歴を消せない。原本は下の作業用に置く。
ref/_thresher_raw/

# ══ 4本目：サーフサイド（Champlain Towers South / 2021-06-24）══════════
# 中身は3種。出どころと根拠は ref/CREDITS.md の台帳と1対1。すべて NIST の職務著作＝PD。
#   tf_pNNN_*.jpg … 技術的知見（2026-06-22・77分の4K動画）のスライドを1コマ抜いて切り出したもの
#                    ⚠️ `©2021 Used with permission` の写真（p45/p103/p119/p147、p50・p52 の右上）と
#                       Google の画像（p184）、管財人の写真と原図（p57・p58）は**切り落としてある**
#   fb_<cid>.jpg  … 記録映像（B-Roll）のひかえの静止画（動画のコマが取れないときだけ出る）
#   ss_*.jpg      … 記録映像からわざと抜いた1コマ（空撮など）
!ref/surfside/
# 🔴 4K の原コマ（PNG・1枚4〜9MB）は analytics/ に置く。ここには入れない。

# 🔴 ナレーションの wav はリポジトリに入れない（1本34分で163MB）。
#    git は履歴を消せないので、作り直すたびに積み上がる。
#    **コミットするのは audio/opus/*.opus（22MB）**。クラウドは焼く前に
#    `python tools/audio_pack.py unpack` で wav に戻す（audio_mix.py は無変更）。
audio/*.wav
# 読みのドライラン結果と、通し確認用につないだ音声（どちらも作り直せる）
audio/kana_dry.txt
audio/_full.mp3
# 🔴 ElevenLabs の行ごとの合成キャッシュ（pcm。1本で約100MB・作り直せる）。
#    検査の記録 audio/el_qa/*.tsv は小さいので入れる（検査台帳の正本）
audio/el_cache/
# USCG報告書は335ページ26MB。ヘッダー付きでいつでも落とせるので入れない
#   → 落とし方は Vault の引き継ぎノートに書いてある
ref/uscg_titan_mbi.pdf

# 🔴 既製BGM（DOVA-SYNDROME）は**作者が再配布を禁止**しているので置かない。
#    このリポジトリは public。Modal の保管庫から読む（tools/audio_mix.py 参照）
assets/

# 🔴🔴 YouTube の OAuth トークンと投稿メタ（2026-08-02）。**このリポジトリは public。**
#    token を1度でも push したら、その瞬間にチャンネルを他人へ渡したのと同じになる。
#    git は履歴を消せないので、消しても取り返せない。
#    → `tools/upload_jiko.py` は保存する前に `git check-ignore` で無視を実測し、
#      無視されていなければ**書かずに落ちる**（この行を消すと落ちるようにしてある）。
config/

# 🔴 アナリティクスの取得結果は public リポジトリに置かない（2026-08-07）。
#    チャンネルの内部数字（再生・維持・CTR・Studio の CSV）が入る。
analytics/

