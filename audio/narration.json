  "subtitles": {
    "p1": [
      {
        "t": 0.0,
        "d": 6.77,
        "text": "1988年4月28日。ハワイ上空、高度7300メートル。"
      },
      {
        "t": 6.95,
        "d": 3.02,
        "text": "飛行中の旅客機から、屋根が消えた。"
      }
    ],
    "p2": [
      {
        "t": 0.0,
        "d": 4.936,
        "text": "事故を起こしたのは、19年間この島々を飛び続けた1機だった。"
      }
    ],
    "c2": [
      {
        "t": 0.0,
        "d": 5.017,
        "text": "失われたのは、前方の扉のすぐ後ろから、5.5メートル。"
      },
      {
        "t": 5.197,
        "d": 4.181,
        "text": "天井から窓の下までが、一続きに剥ぎ取られていた。"
      }
    ],
    "p3": [
      {
        "t": 0.0,
        "d": 3.484,
        "text": "着陸した機体を、調査員が見上げている。"
      },
      {
        "t": 3.664,
        "d": 4.495,
        "text": "外板が無くなり、客室の骨組みが、そのまま外に出ていた。"
      }
    ],
    "c3": [
      {
        "t": 0.0,
        "d": 5.447,
        "text": "失われたのは、胴体の上半分。円周の、およそ55パーセント。"
      },
      {
        "t": 5.627,
        "d": 4.204,
        "text": "与圧された筒は、一度裂けると、一気に広がる。"
      }
    ],
    "c4": [
      {
        "t": 0.0,
        "d": 3.961,
        "text": "始まりは、リベット1列の、小さな亀裂だった。"
      },
      {
        "t": 4.141,
        "d": 3.972,
        "text": "搭乗する乗客の1人が、この亀裂を見ていた。"
      },
      {
        "t": 8.293,
        "d": 2.347,
        "text": "だが、誰にも言わなかった。"
      }
    ],
    "c5": [
      {
        "t": 0.0,
        "d": 5.156,
        "text": "外板は2枚が重なり、接着とリベットで荷重を分け合う設計だった。"
      },
      {
        "t": 5.336,
        "d": 3.728,
        "text": "その接着が、潮風の中で剥がれていた。"
      },
      {
        "t": 9.245,
        "d": 3.752,
        "text": "荷重の行き場は、リベット穴の縁だけになった。"
      }
    ],
    "p4": [
      {
        "t": 0.0,
        "d": 5.539,
        "text": "島から島へ、20分の飛行。1日に十数回、上がっては、降りる。"
      }
    ],
    "c6": [
      {
        "t": 0.0,
        "d": 2.695,
        "text": "剥離から着陸まで、13分。"
      },
      {
        "t": 2.875,
        "d": 5.725,
        "text": "操縦室の扉も吹き飛び、機長は、客室の空を、直接見ていた。"
      }
    ],
    "c7": [
      {
        "t": 0.0,
        "d": 3.217,
        "text": "設計上の想定は、7万5000回。"
      },
      {
        "t": 3.397,
        "d": 4.309,
        "text": "この機体は、8万9680回、飛んでいた。"
      }
    ]
  }
}