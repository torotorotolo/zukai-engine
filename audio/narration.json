  "subtitles": {
    "c101": [
      {
        "t": 0.0,
        "d": 4.106,
        "text": "2026年10月、大分県別府市。ヨットが並ぶ港のそばで、"
      },
      {
        "t": 4.596,
        "d": 2.582,
        "text": "警察が2日間、海を調べ、ボートも出した。"
      }
    ],
    "c102": [
      {
        "t": 0.0,
        "d": 3.639,
        "text": "4年前の夜、その港のあたりで、ひとりの男の足取りが途絶えた。"
      },
      {
        "t": 4.129,
        "d": 2.604,
        "text": "警察は、その男を、いまも探し続けている。"
      }
    ],
    "c103": [
      {
        "t": 0.0,
        "d": 5.257,
        "text": "2026年9月末までに、警察に寄せられた情報は、1万3978件。"
      },
      {
        "t": 5.747,
        "d": 2.009,
        "text": "そんなにあるのに、まだ見つからないなんて。",
        "who": "q"
      },
      {
        "t": 8.246,
        "d": 3.465,
        "text": "それでも、逮捕につながる有力な手がかりは、まだ得られていないという。"
      }
    ],
    "c104": [
      {
        "t": 0.0,
        "d": 4.247,
        "text": "始まりは、2022年6月29日の夜だ。別府市の交差点で、"
      },
      {
        "t": 4.737,
        "d": 3.318,
        "text": "赤信号で止まっていたバイク2台に、後ろから車が追突した。"
      }
    ],
    "c105": [
      {
        "t": 0.0,
        "d": 3.622,
        "text": "19歳の大学2年生が亡くなり、友人の大学生がけがをした。"
      },
      {
        "t": 4.112,
        "d": 2.838,
        "text": "運転していた男は、車を残し、裸足で逃げた。"
      }
    ],
    "c106": [
      {
        "t": 0.0,
        "d": 3.477,
        "text": "警察は、この男を、八田與一容疑者とみている。いまは、"
      },
      {
        "t": 3.967,
        "d": 3.48,
        "text": "殺人と殺人未遂などの疑いで、全国に指名手配されている。"
      }
    ],
    "c107": [
      {
        "t": 0.0,
        "d": 1.97,
        "text": "事件の夜から、いったい何があったの？",
        "who": "q"
      },
      {
        "t": 2.46,
        "d": 3.293,
        "text": "最初の夜から、最新の海の捜索まで、起きた順にたどる。"
      },
      {
        "t": 6.243,
        "d": 3.038,
        "text": "分かっていることと、まだ分かっていないことを、分けて見ていく。"
      }
    ],
    "c201": [
      {
        "t": 0.0,
        "d": 2.299,
        "text": "バイクに乗っていたのは、どんな人たちだったの？",
        "who": "q"
      },
      {
        "t": 2.789,
        "d": 3.176,
        "text": "大学生の、友人どうしの2人だ。ひとりはミニバイク、"
      },
      {
        "t": 6.456,
        "d": 1.488,
        "text": "もうひとりはオートバイに乗っていた。"
      }
    ],
    "c202": [
      {
        "t": 0.0,
        "d": 5.491,
        "text": "2022年6月29日、夜7時45分ごろ。別府市野口原の県道の交差点で、"
      },
      {
        "t": 5.981,
        "d": 2.994,
        "text": "2人は、赤信号で止まり、信号が変わるのを待っていた。"
      }
    ],
    "c203": [
      {
        "t": 0.0,
        "d": 4.125,
        "text": "そこへ、坂を下ってきた軽乗用車が、止まっていた2台に後ろから追突した。"
      },
      {
        "t": 4.615,
        "d": 3.053,
        "text": "車はそのまま、そばの信号機の柱にぶつかって止まった。"
      }
    ],
    "c204": [
      {
        "t": 0.0,
        "d": 3.239,
        "text": "ミニバイクに乗っていた、19歳の大学2年生が亡くなった。"
      },
      {
        "t": 3.729,
        "d": 3.532,
        "text": "オートバイの友人も、けがをした。けがは軽かったと報じられている。"
      }
    ],
    "c205": [
      {
        "t": 0.0,
        "d": 3.519,
        "text": "車を運転していた男は、車をその場に残し、走って逃げた。"
      },
      {
        "t": 4.01,
        "d": 4.103,
        "text": "防犯カメラの映像などから、男は靴をはいておらず、裸足だったとみられている。"
      }
    ],
    "c206": [
      {
        "t": 0.0,
        "d": 1.69,
        "text": "追突の前に、何かあったの？",
        "who": "q"
      },
      {
        "t": 2.18,
        "d": 3.237,
        "text": "追突の少し前、2人は、現場の近くの商業施設で、"
      },
      {
        "t": 5.907,
        "d": 1.785,
        "text": "ひとりの男と、顔を合わせていた。"
      }
    ],
    "c207": [
      {
        "t": 0.0,
        "d": 2.744,
        "text": "けがをした友人は、テレビ局の取材にこう話している。"
      },
      {
        "t": 3.234,
        "d": 2.497,
        "text": "スピーカーで大きな音を流しながら歩いてきた男と、"
      },
      {
        "t": 6.221,
        "d": 1.954,
        "text": "亡くなった友人の目が合ったらしい、と。"
      }
    ],
    "c208": [
      {
        "t": 0.0,
        "d": 3.2,
        "text": "けがをした友人によると、男が、言いがかりをつけてきたらしい。"
      },
      {
        "t": 3.69,
        "d": 3.122,
        "text": "やり取りは、15秒か30秒ぐらいだった、と話している。"
      }
    ],
    "c209": [
      {
        "t": 0.0,
        "d": 1.238,
        "text": "それから、どうなったの？",
        "who": "q"
      },
      {
        "t": 1.728,
        "d": 1.913,
        "text": "そのあと、交差点で追突が起きた。"
      },
      {
        "t": 4.13,
        "d": 3.449,
        "text": "2つの出来事につながりがあるのかは、まだ裁判で確かめられていない。"
      }
    ],
    "c210": [
      {
        "t": 0.0,
        "d": 3.922,
        "text": "当時の報道によると、車は、時速40キロの制限を大きく上回る、"
      },
      {
        "t": 4.412,
        "d": 3.789,
        "text": "70キロ以上で走っていたとみられる。ブレーキの跡も残っていなかった。"
      }
    ],
    "c211": [
      {
        "t": 0.0,
        "d": 4.827,
        "text": "1年後には、捜査関係者の話として、時速100キロ近くとみられる、とも報じられた。"
      },
      {
        "t": 5.317,
        "d": 1.968,
        "text": "速さの数字は、報道によって違う。"
      }
    ],
    "c212": [
      {
        "t": 0.0,
        "d": 1.334,
        "text": "男は、どこへ逃げたの？",
        "who": "q"
      },
      {
        "t": 1.824,
        "d": 4.14,
        "text": "警察は2023年5月、町の防犯カメラ8台の映像から割り出した、"
      },
      {
        "t": 6.454,
        "d": 4.252,
        "text": "男が逃げたとみられる道すじを公表した。事件から、1年近くたっていた。"
      }
    ],
    "c213": [
      {
        "t": 0.0,
        "d": 2.746,
        "text": "交差点から、青山町を抜けて、上田の湯町へ。"
      },
      {
        "t": 3.236,
        "d": 2.678,
        "text": "男は、裸足のまま、町の中を走っていった。"
      }
    ],
    "c214": [
      {
        "t": 0.0,
        "d": 2.215,
        "text": "さらに、JR別府駅のそばを通り抜け、"
      },
      {
        "t": 2.705,
        "d": 2.788,
        "text": "海に近い、北浜の飲食店が並ぶ通りへ向かった。"
      }
    ],
    "c215": [
      {
        "t": 0.0,
        "d": 2.611,
        "text": "海沿いの国道10号を渡り、ヨットハーバーの方へ。"
      },
      {
        "t": 3.101,
        "d": 2.586,
        "text": "事件の交差点から、およそ2キロ離れた所だ。"
      }
    ],
    "c216": [
      {
        "t": 0.0,
        "d": 2.243,
        "text": "男の足取りが分かるのは、このあたりまでだ。"
      },
      {
        "t": 2.733,
        "d": 2.808,
        "text": "この先、男がどこへ向かったのかは、分かっていない。"
      }
    ],
    "c217": [
      {
        "t": 0.0,
        "d": 3.512,
        "text": "事件の2日後、ヨットハーバーの近くで、黒いTシャツが見つかった。"
      }
    ],
    "c218": [
      {
        "t": 0.0,
        "d": 4.351,
        "text": "報道によると、Tシャツから取ったDNAの型は、容疑者のものと一致したとされる。"
      }
    ],
    "c219": [
      {
        "t": 0.0,
        "d": 2.217,
        "text": "海のそばで、行方が分からなくなったんだね。",
        "who": "q"
      }
    ],
    "c220": [
      {
        "t": 0.0,
        "d": 3.768,
        "text": "そう。ここから、男を探す警察の捜査が、長く続いていく。"
      },
      {
        "t": 4.258,
        "d": 3.524,
        "text": "警察は、手配書やチラシを作り、くり返し情報を呼びかけていく。"
      }
    ],
    "c301": [
      {
        "t": 0.0,
        "d": 1.762,
        "text": "警察は、すぐに名前を出したの？",
        "who": "q"
      },
      {
        "t": 2.252,
        "d": 3.185,
        "text": "事件の5日後の2022年7月4日。警察は、"
      },
      {
        "t": 5.928,
        "d": 3.86,
        "text": "当時25歳の八田與一容疑者の名前と顔写真を公表し、手配した。"
      }
    ],
    "c302": [
      {
        "t": 0.0,
        "d": 2.882,
        "text": "疑いは、道路交通法違反。いわゆる「ひき逃げ」だ。"
      }
    ],
    "c303": [
      {
        "t": 0.0,
        "d": 4.369,
        "text": "7月28日には、男が逃げる姿をとらえた防犯カメラの映像を公開した。"
      },
      {
        "t": 4.859,
        "d": 2.929,
        "text": "このころ、寄せられた情報は、まだ36件だった。"
      },
      {
        "t": 8.279,
        "d": 2.544,
        "text": "警察の映像の公開は、このあとも続いていく。"
      }
    ],
    "c304": [
      {
        "t": 0.0,
        "d": 3.177,
        "text": "11月には、亡くなった大学生の両親が、独自に、"
      },
      {
        "t": 3.667,
        "d": 4.856,
        "text": "最大500万円の懸賞金を出すと発表した。ホームページも作り、情報を呼びかけた。"
      }
    ],
    "c305": [
      {
        "t": 0.0,
        "d": 4.754,
        "text": "2023年5月、警察は、本人とされる人物が写った動画10本を公開した。"
      },
      {
        "t": 5.244,
        "d": 2.742,
        "text": "知人と話す、本人のものとされる声も入っていた。"
      }
    ],
    "c306": [
      {
        "t": 0.0,
        "d": 3.579,
        "text": "同じ日、Tシャツや、車に残されていたスリッパ、リュックサック、"
      },
      {
        "t": 4.069,
        "d": 2.469,
        "text": "そして、土地勘があるとみられる地域も公表した。"
      }
    ],
    "c307": [
      {
        "t": 0.0,
        "d": 1.415,
        "text": "遺族は、どう受け止めたの？",
        "who": "q"
      },
      {
        "t": 1.905,
        "d": 3.648,
        "text": "遺族は、「なぜ、今なんですか。」とコメントした、と報じられた。"
      },
      {
        "t": 6.043,
        "d": 4.404,
        "text": "映像や、残された物の公開が、なぜ1年近くたってからなのか、という声だ。"
      }
    ],
    "c308": [
      {
        "t": 0.0,
        "d": 5.46,
        "text": "事件から1年の2023年6月29日、警察は、JR別府駅などでチラシを配った。"
      },
      {
        "t": 5.95,
        "d": 2.789,
        "text": "寄せられた情報は、このとき854件だった。"
      }
    ],
    "c309": [
      {
        "t": 0.0,
        "d": 2.389,
        "text": "そして2023年9月、警察庁は、"
      },
      {
        "t": 2.879,
        "d": 2.783,
        "text": "八田與一容疑者を「重要指名手配」の容疑者に指定した。"
      },
      {
        "t": 6.152,
        "d": 3.697,
        "text": "警察庁の手配のページには、身長175センチくらい、とある。"
      }
    ],
    "c310": [
      {
        "t": 0.0,
        "d": 5.076,
        "text": "重要指名手配は、全国の警察がとくに力を入れて探す容疑者を、警察庁が選ぶものだ。"
      },
      {
        "t": 5.566,
        "d": 3.296,
        "text": "道路交通法違反の疑いでの指定は、全国で初めてだった。"
      }
    ],
    "c311": [
      {
        "t": 0.0,
        "d": 3.712,
        "text": "報道によると、警察庁は、この事件を「殺人に近い形態」とみた。"
      },
      {
        "t": 4.202,
        "d": 1.852,
        "text": "情報を寄せた人に、お礼は出るの？",
        "who": "q"
      }
    ],
    "c312": [
      {
        "t": 0.0,
        "d": 5.38,
        "text": "出る。9月15日、国の「捜査特別報奨金」の対象になった。上限は300万円。"
      },
      {
        "t": 5.87,
        "d": 3.595,
        "text": "逮捕などに結びつく有力な情報を寄せた人に、国が払うお金だ。"
      },
      {
        "t": 9.955,
        "d": 5.6,
        "text": "重要指名手配と報奨金は大分県で初めて。遺族らの懸賞金と合わせ、最大800万円だ。"
      }
    ],
    "c313": [
      {
        "t": 0.0,
        "d": 4.106,
        "text": "2024年6月には、いまの姿を想像した似顔絵6枚が公開された。"
      },
      {
        "t": 4.596,
        "d": 3.14,
        "text": "髪を伸ばした姿や、ひげの姿、眼鏡の姿などだ。"
      }
    ],
    "c314": [
      {
        "t": 0.0,
        "d": 3.237,
        "text": "逃げている人の心の動きも考えて描いた、という報道もある。"
      },
      {
        "t": 3.727,
        "d": 2.029,
        "text": "見た目を変えているかもしれない、ということ？",
        "who": "q"
      }
    ],
    "c315": [
      {
        "t": 0.0,
        "d": 4.356,
        "text": "警察は2024年7月、容疑者が、髪型を変えたり、ひげを生やしたり、"
      },
      {
        "t": 4.846,
        "d": 2.708,
        "text": "体型が変わったりしている可能性がある、と呼びかけた。"
      }
    ],
    "c316": [
      {
        "t": 0.0,
        "d": 4.083,
