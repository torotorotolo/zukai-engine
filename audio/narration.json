        "t": 5.204,
        "d": 3.539,
        "text": "会社が確かめた人に、区分ごとに1万円から2万5000円を払う。"
      }
    ],
    "c607": [
      {
        "t": 0.0,
        "d": 1.307,
        "text": "全部で、いくらになるの？",
        "who": "q"
      },
      {
        "t": 1.797,
        "d": 4.107,
        "text": "区分を全部足すと、5万円だ。上限は「1公開につき」300万円とある。"
      },
      {
        "t": 6.394,
        "d": 2.217,
        "text": "「1公開」が何を指すのかは、書かれていない。"
      }
    ],
    "c608": [
      {
        "t": 0.0,
        "d": 4.114,
        "text": "支払いの総額は、10月28日の時点で出せていない、と会社は書いた。"
      }
    ],
    "c609": [
      {
        "t": 0.0,
        "d": 5.924,
        "text": "11月2日、会社は役員4人の報酬を減らすと決めた。代表は月額の30%を3カ月だ。"
      },
      {
        "t": 6.414,
        "d": 3.168,
        "text": "検証のあと、改めて経営の責任を検討する、という。"
      }
    ],
    "c610": [
      {
        "t": 0.0,
        "d": 1.138,
        "text": "代表は、辞めるの？",
        "who": "q"
      },
      {
        "t": 1.628,
        "d": 4.094,
        "text": "辞任を問われ、悪意に汚染されたインターネットを放置できない、という趣旨で答えた。"
      },
      {
        "t": 6.212,
        "d": 3.343,
        "text": "否定かと重ねて問われ、「先ほど私が申し上げた通り」と話した。"
      }
    ],
    "c611": [
      {
        "t": 0.0,
        "d": 5.117,
        "text": "会社は10月24日、能動的サイバー防御の「発動第1号」として、国が動くよう求めた。"
      },
      {
        "t": 5.607,
        "d": 4.426,
        "text": "被害が深刻になる前に、国が攻撃の基盤を止めにいく枠組みだ、と会社は書く。"
      }
    ],
    "c612": [
      {
        "t": 0.0,
        "d": 1.705,
        "text": "会社が頼めば、国は動くの？",
        "who": "q"
      },
      {
        "t": 2.195,
        "d": 3.429,
        "text": "民間の求めで国が動く手続は、法律の原文に見当たらない。"
      },
      {
        "t": 6.114,
        "d": 3.115,
        "text": "その法律は10月1日に、一部が始まったばかりだった。"
      }
    ],
    "c613": [
      {
        "t": 0.0,
        "d": 3.208,
        "text": "代表も、申請をして政府が動く制度ではない、と話した。"
      },
      {
        "t": 3.698,
        "d": 3.256,
        "text": "担当の大臣は10月27日、政府の対応は明かさず、"
      },
      {
        "t": 7.445,
        "d": 4.56,
        "text": "一般論として、被害組織から情報を受けて、必要な支援や措置をとる、と答えた。"
      }
    ],
    "c614": [
      {
        "t": 0.0,
        "d": 2.425,
        "text": "説明会で、代表はAIの脅威も語った。"
      }
    ],
    "c615": [
      {
        "t": 0.0,
        "d": 2.475,
        "text": "今回AIが使われた証拠はあるのか、と問われ、"
      },
      {
        "t": 2.965,
        "d": 3.533,
        "text": "代表は、基本的に、AIが使われた証拠は無い、と答えた。"
      },
      {
        "t": 6.987,
        "d": 4.688,
        "text": "使われたかは分からず、事件とAIの話は別で、AIのせいにはしていない、と話した。"
      }
    ],
    "c616": [
      {
        "t": 0.0,
        "d": 4.145,
        "text": "SNS上では、「AIと事件の問題の本質は直接的に関係ないような」、"
      },
      {
        "t": 4.635,
        "d": 3.262,
        "text": "「AIの脅威に問題点をすり替えているように聞こえた」という声が挙がった。"
      }
    ],
    "c617": [
      {
        "t": 0.0,
        "d": 1.684,
        "text": "こんな声もある。聞きたいのは、"
      },
      {
        "t": 2.174,
        "d": 3.438,
        "text": "「今年の8月に侵入されていたのに10月まで気づかなかった理由だ」。"
      }
    ],
    "c619": [
      {
        "t": 0.0,
        "d": 4.859,
        "text": "一方で、SNS上では、「侵入に2カ月半気づけなかった会社の責任も重い」としつつ、"
      },
      {
        "t": 5.349,
        "d": 3.523,
        "text": "「それでも、叩く順番はまず犯人じゃない？」という声も挙がっている。"
      }
    ],
    "c620": [
      {
        "t": 0.0,
        "d": 2.649,
        "text": "怒る声も、順番を問う声も、両方あるんだね。",
        "who": "q"
      },
      {
        "t": 3.139,
        "d": 4.162,
        "text": "そう。なぜ気づけなかったかの答えは、11月3日の時点で、まだ無い。"
      }
    ],
    "c701": [
      {
        "t": 0.0,
        "d": 4.673,
        "text": "では、いま、できることは何か。会社の相談の窓口は、24時間開いている。"
      },
      {
        "t": 5.163,
        "d": 2.352,
        "text": "電話番号は、画面と説明欄に書いておく。"
      }
    ],
    "c702": [
      {
        "t": 0.0,
        "d": 2.128,
        "text": "公開された情報を、見てみたくなったら？",
        "who": "q"
      },
      {
        "t": 2.618,
        "d": 4.573,
        "text": "見に行かない。広めない。見た人の情報は取られている、と会社は警告している。"
      }
    ],
    "c703": [
      {
        "t": 0.0,
        "d": 5.231,
        "text": "攻撃した者についての情報は、会社の専用の窓口で受ける。場所は画面と説明欄に書く。"
      },
      {
        "t": 5.721,
        "d": 4.948,
        "text": "会社は、「ご自身での犯人の特定や接触、確証のない情報の投稿」を控えるよう求める。"
      }
    ],
    "c704": [
      {
        "t": 0.0,
        "d": 2.412,
        "text": "会社は、パスワードや認証コードは聞かないとし、"
      },
      {
        "t": 2.902,
        "d": 3.247,
        "text": "「被害金を取り戻す」と費用を求める連絡には応じないよう呼びかける。"
      },
      {
        "t": 6.639,
        "d": 2.301,
        "text": "国も、相談の窓口の案内を載せている。"
      }
    ],
    "c705": [
      {
        "t": 0.0,
        "d": 3.517,
        "text": "11月3日の時点で、攻撃した者が誰かは公表されていない。"
      },
      {
        "t": 4.007,
        "d": 4.909,
        "text": "なぜ76日のあいだ、気づけなかったのか。答えは、今後の検証に委ねられている。"
      }
    ],
    "c706": [
      {
        "t": 0.0,
        "d": 3.785,
        "text": "あなたは、使っているサービスが攻撃を受けたと知ったら、まず何をしますか。"
      },
      {
        "t": 4.275,
        "d": 1.813,
        "text": "よければ、コメントで教えてください。"
      }
    ],
    "ed01": [
      {
        "t": 0.0,
        "d": 1.349,
        "text": "ご視聴ありがとうございました。"
      },
      {
        "t": 1.839,
        "d": 2.274,
        "text": "この動画が少しでも気に入れば、高評価と"
      },
      {
        "t": 4.603,
        "d": 1.476,
        "text": "チャンネル登録をお願いします。"
      }
    ]
  },
