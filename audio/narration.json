  "subtitles": {
    "c101": [
      {
        "t": 0.0,
        "d": 5.072,
        "text": "2026年10月27日の朝、ネットの会社が、利用者に、こんなお願いを出した。"
      },
      {
        "t": 5.562,
        "d": 3.492,
        "text": "12時になる前に、電源を落とし、パソコンのコードを抜いてください。"
      }
    ],
    "c102": [
      {
        "t": 0.0,
        "d": 4.51,
        "text": "攻撃した者が、情報の公開と、データを人質に取る攻撃を、予告していた。"
      },
      {
        "t": 5.0,
        "d": 2.058,
        "text": "最初の要求は、約80億円だ。"
      }
    ],
    "c103": [
      {
        "t": 0.0,
        "d": 3.771,
        "text": "FXの口座を、他人に動かされた利用者がいる。報道によると、"
      },
      {
        "t": 4.261,
        "d": 4.256,
        "text": "45秒で97件の取引をされ、残高が47円になった人もいる。"
      }
    ],
    "c104": [
      {
        "t": 0.0,
        "d": 1.317,
        "text": "会社は、いつ気づいたの？",
        "who": "q"
      },
      {
        "t": 1.807,
        "d": 4.998,
        "text": "会社の説明では、最初の侵入は8月5日。異変を確かめたのは、10月20日だ。"
      }
    ],
    "c105": [
      {
        "t": 0.0,
        "d": 2.296,
        "text": "そのあいだ76日、およそ2カ月半。"
      },
      {
        "t": 2.786,
        "d": 3.428,
        "text": "「その間気づくことができませんでした」と、会社の副社長は話した。"
      },
      {
        "t": 6.704,
        "d": 2.756,
        "text": "調べ始めたきっかけは、利用者からの問い合わせだった。"
      }
    ],
    "c106": [
      {
        "t": 0.0,
        "d": 2.451,
        "text": "2年前、同じグループのセキュリティの専門家が、"
      },
      {
        "t": 2.941,
        "d": 4.147,
        "text": "今回のサービスの改善点を指摘していた。侵入との関係は、分からない。"
      }
    ],
    "c107": [
      {
        "t": 0.0,
        "d": 4.506,
        "text": "詳しい手口も、攻撃した者が誰かも、11月3日の時点で公表されていない。"
      },
      {
        "t": 4.996,
        "d": 0.888,
        "text": "何が起きていたの？",
        "who": "q"
      },
      {
        "t": 6.375,
        "d": 4.818,
        "text": "会社の発表と、11月2日の説明会、国の記録、報道で、順にたどる。"
      }
    ],
    "c201": [
      {
        "t": 0.0,
        "d": 1.613,
        "text": "そもそも、どこのサービスなの？",
        "who": "q"
      },
      {
        "t": 2.103,
        "d": 3.7,
        "text": "お名前.com デスクトップクラウド。運営会社はGMOインターネット、"
      },
      {
        "t": 6.293,
        "d": 1.997,
        "text": "親会社はGMOインターネットグループだ。"
      }
    ],
    "c202": [
      {
        "t": 0.0,
        "d": 3.893,
        "text": "ネットの向こうのコンピューター、サーバーを1台ぶん借りる。これがVPSだ。"
      },
      {
        "t": 4.383,
        "d": 3.814,
        "text": "手元のパソコンから、その画面を開いて動かすのが、リモートデスクトップ。"
      }
    ],
    "c203": [
      {
        "t": 0.0,
        "d": 5.146,
        "text": "このサービスは、FXの自動売買向けとされる。FXとは、外国のお金の売り買いで、"
      },
      {
        "t": 5.636,
        "d": 3.371,
        "text": "自動売買は、それをプログラムに任せて、動かし続けることだ。"
      }
    ],
    "c204": [
      {
        "t": 0.0,
        "d": 4.501,
        "text": "だから借りた1台の中に、取引の口座に入るための情報が、置かれていることがある。"
      }
    ],
    "c205": [
      {
        "t": 0.0,
        "d": 3.874,
        "text": "10月19日、利用者からの問い合わせを受けて、会社は調査を始めた。"
      },
      {
        "t": 4.364,
        "d": 4.211,
        "text": "翌20日、一部の利用者のサーバーに、不正なプログラムが置かれているのを確かめた。"
      }
    ],
    "c206": [
      {
        "t": 0.0,
        "d": 3.712,
        "text": "新しい申し込みと、管理の画面を止め、21日の午前4時から、"
      },
      {
        "t": 4.202,
        "d": 2.021,
        "text": "全プランのサーバーを、順に止めていった。"
      }
    ],
    "c207": [
      {
        "t": 0.0,
        "d": 5.399,
        "text": "最初の知らせ、第1報は、影響の可能性があるサーバーを、2万6739件とした。"
      },
      {
        "t": 5.889,
        "d": 4.233,
        "text": "見られた可能性はあるが、預かる個人情報の漏えいや、情報の悪用の事実は、"
      },
      {
        "t": 10.611,
        "d": 1.269,
        "text": "確認されていない、と。"
      }
    ],
    "c208": [
      {
        "t": 0.0,
        "d": 5.025,
        "text": "この2万6739は、対象となり得る数だ。不正アクセスや情報の取得を、"
      },
      {
        "t": 5.515,
        "d": 2.719,
        "text": "確かめた数ではない、と会社はのちに説明している。"
      }
    ],
    "c209": [
      {
        "t": 0.0,
        "d": 1.97,
        "text": "じゃあ、そこまで悪い話じゃなかったの？",
        "who": "q"
      },
      {
        "t": 2.46,
        "d": 4.413,
        "text": "いや。同じ21日、会社に、攻撃した者から脅迫のメールが届く。"
      },
      {
        "t": 7.363,
        "d": 3.021,
        "text": "要求は5000万ドル、会社の言い方で約80億円だ。"
      }
    ],
    "c210": [
      {
        "t": 0.0,
        "d": 3.55,
        "text": "さらに同じ日、利用者のFXの口座が、不正に操作された。"
      },
      {
        "t": 4.04,
        "d": 3.426,
        "text": "わざと損が出る取引だった、と運営会社の社長は説明している。"
      }
    ],
    "c211": [
      {
        "t": 0.0,
        "d": 5.668,
        "text": "報道によると、ある会社経営の男性は、23日の朝、45秒で97件の取引をされ、"
      },
      {
        "t": 6.158,
        "d": 3.272,
        "text": "約50万円を失って、口座の残りは47円になった。"
      }
    ],
    "c212": [
      {
        "t": 0.0,
        "d": 1.312,
        "text": "そんなに、あっという間に。",
        "who": "q"
      },
      {
        "t": 1.802,
        "d": 3.675,
        "text": "30代の利用者が、約650万円を失った例も報じられた。"
      },
      {
        "t": 5.967,
        "d": 3.426,
        "text": "全体の被害の額は、11月3日の時点で公表されていない。"
      }
    ],
    "c213": [
      {
        "t": 0.0,
        "d": 5.287,
        "text": "10月22日、会社は警察に相談した。金融庁も動いた。大臣の説明では、"
      },
      {
        "t": 5.777,
        "d": 4.936,
        "text": "業界の協会を通じて、すべてのFX業者に、注意の呼びかけと監視の強化を求めた。"
      }
    ],
    "c214": [
      {
        "t": 0.0,
        "d": 3.301,
        "text": "大臣は、運営会社は金融庁の担当ではない、と話した。"
      }
    ],
    "c215": [
      {
        "t": 0.0,
        "d": 4.288,
        "text": "22日の第2報は、サーバーの中の口座のログイン情報が、第三者に取られ、"
      },
      {
        "t": 4.778,
        "d": 2.049,
        "text": "不正に使われた可能性がある、とした。"
      }
    ],
    "c216": [
      {
        "t": 0.0,
        "d": 3.217,
        "text": "第3報は、パスワードを変えても、しばらく接続が続いて、"
      },
      {
        "t": 3.707,
        "d": 2.457,
        "text": "第三者が取引できる場合がある、と注意した。"
      },
      {
        "t": 6.655,
        "d": 1.52,
        "text": "変えても、安心できないんだ。",
        "who": "q"
      }
    ],
    "c217": [
      {
        "t": 0.0,
        "d": 3.942,
        "text": "10月24日の第4報は、サービスのシステムにセキュリティ上の問題があり、"
      },
      {
        "t": 4.432,
        "d": 3.236,
        "text": "利用者の情報が外へ持ち出された事実を確かめた、と書いた。"
      }
    ],
    "c218": [
      {
        "t": 0.0,
        "d": 1.79,
        "text": "最初の知らせから、変わったんだね。",
        "who": "q"
      },
      {
        "t": 2.28,
        "d": 2.743,
        "text": "そう。第1報から3日で、書くことが変わった。"
      }
    ],
    "c219": [
      {
        "t": 0.0,
        "d": 3.574,
        "text": "同じ第4報で、会社は、金銭の要求には応じない、とした。"
      },
      {
        "t": 4.064,
        "d": 2.011,
        "text": "見舞金と、損失の補償も決めた。"
      }
    ],
    "c220": [
      {
        "t": 0.0,
        "d": 2.258,
        "text": "要求に応じなければ、情報を公開する。"
      },
      {
        "t": 2.748,
        "d": 1.864,
        "text": "そういう連絡も、会社は受けていた。"
      }
    ],
    "c301": [
      {
        "t": 0.0,
        "d": 1.58,
        "text": "要求の額は、どうなったの？",
        "who": "q"
      },
      {
        "t": 2.07,
        "d": 4.25,
        "text": "報道によると、攻撃した者は10月24日、要求を100万ドルに下げた。"
      },
      {
        "t": 6.81,
        "d": 1.859,
        "text": "自分のサイトで、この額を示した。"
      }
    ],
    "c318": [
      {
        "t": 0.0,
        "d": 3.58,
        "text": "グループの代表は説明会で、攻撃した者から窓口への連絡は、"
      },
      {
        "t": 4.07,
        "d": 3.842,
        "text": "10月23日の夜8時40分以降、入っていない、と答えた。"
      }
    ],
    "c302": [
      {
        "t": 0.0,
        "d": 3.987,
        "text": "10月25日、会社は利用者に、パソコンの調査への協力を頼んだ。"
      },
      {
        "t": 4.477,
        "d": 3.392,
        "text": "社員が全国をまわって、パソコンを預かり、中を調べ始めた。"
      }
    ],
    "c303": [
      {
        "t": 0.0,
        "d": 3.777,
        "text": "不正なプログラムの有無を含め、手元のパソコンの被害を確かめる、という。"
      }
    ],
    "c304": [
      {
        "t": 0.0,
        "d": 3.966,
        "text": "10月26日の夜、第7報で、会社は予告を受けていると明かした。"
      },
      {
        "t": 4.456,
        "d": 4.437,
        "text": "27日の12時に、情報の公開とランサムウェアの攻撃を行う、というものだ。"
      }
    ],
    "c305": [
      {
        "t": 0.0,
        "d": 1.936,
        "text": "ランサムウェアとは、データを使えなくして、"
      },
      {
        "t": 2.426,
        "d": 2.146,
        "text": "元に戻す代わりに金を求めるプログラムだ。"
      }
    ],
    "c306": [
      {
        "t": 0.0,
        "d": 4.358,
        "text": "翌朝の9時58分、第8報。12時になる前に、バックアップを取り、"
      },
      {
        "t": 4.848,
        "d": 3.134,
        "text": "ネットワークを切り、電源を落とし、コードを抜いてほしい、と。"
      }
    ],
    "c308": [
      {
        "t": 0.0,
        "d": 1.148,
        "text": "そんなに急に言われても。",
        "who": "q"
      },
      {
        "t": 1.638,
        "d": 4.364,
        "text": "第9報は、ランサムウェアの被害に遭ったら、同じ性能の新しいパソコンを出すとした。"
      }
    ],
    "c309": [
      {
        "t": 0.0,
        "d": 3.931,
        "text": "そして報道によると正午すぎ、1件の情報だというものが、公開された。"
      },
      {
        "t": 4.421,
        "d": 2.567,
        "text": "会社がそれを確かめたのは、12時30分だ。"
      }
    ],
    "c307": [
      {
        "t": 0.0,
        "d": 4.055,
        "text": "SNS上では、「正午になる前にPCの電源切ってとかいう呼びかけ今知った」、"
      },
      {
        "t": 4.545,
        "d": 2.874,
        "text": "「こんなん気づかなかった人が殆どなのでは」という声が挙がった。"
      }
    ],
    "c310": [
      {
        "t": 0.0,
        "d": 4.12,
        "text": "13時55分の第10報は、公開されたものを「情報と称するもの」と書いた。"
      },
      {
        "t": 4.61,
        "d": 2.633,
        "text": "事実と異なる内容が含まれるおそれがある、とした。"
      },
      {
        "t": 7.733,
        "d": 2.727,
        "text": "ランサムウェアの攻撃は、この時点で確認されていない。"
      }
    ],
    "c311": [
      {
        "t": 0.0,
        "d": 4.062,
        "text": "会社は、公開先のサイトを見ないでほしい、広めないでほしい、と呼びかけた。"
      },
      {
        "t": 4.552,
        "d": 3.178,
        "text": "見に行った人の情報は、攻撃した者に取られている、という。"
      }
    ],
    "c312": [
      {
        "t": 0.0,
        "d": 2.232,
        "text": "公開されたものについて、誰か話したの？",
        "who": "q"
      },
      {
        "t": 2.722,
        "d": 2.247,
        "text": "報道によると、氏名などが同じ人物が、"
      },
      {
        "t": 5.459,
        "d": 2.99,
        "text": "GMOのクラウドサービスは一度も使っていない、と話した。"
      }
    ],
    "c313": [
      {
        "t": 0.0,
        "d": 4.617,
        "text": "一方、運営会社の社長は説明会で、1件の情報が掲載された、と話した。"
      },
      {
        "t": 5.107,
        "d": 3.126,
        "text": "その人物についても、中身についても、これ以上は触れない。"
      }
    ],
    "c314": [
      {
        "t": 0.0,
        "d": 4.492,
        "text": "27日の夜の第12報で、会社は、要求には「永久に」応じない、と書いた。"
      },
      {
        "t": 4.982,
        "d": 3.081,
        "text": "ここから、会社は攻撃した者を、「犯人」と呼ぶようになる。"
      }
    ],
    "c315": [
      {
        "t": 0.0,
        "d": 4.537,
        "text": "同時に、手がかりの情報に懸賞金を出すと決めた。上限は総額100万ドルだ。"
      },
      {
        "t": 5.027,
