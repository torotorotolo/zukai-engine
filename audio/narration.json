  "subtitles": {
    "c101": [
      {
        "t": 0.0,
        "d": 2.876,
        "text": "2026年9月25日、午前9時7分。"
      },
      {
        "t": 3.366,
        "d": 1.909,
        "text": "カーシェアのタイムズカーを運営する会社が、"
      },
      {
        "t": 5.766,
        "d": 2.539,
        "text": "システムへの、外からの不正なアクセスに気づいた。"
      }
    ],
    "c102": [
      {
        "t": 0.0,
        "d": 4.44,
        "text": "3日後、会社は、約660万件の個人の情報が漏えいしたと発表した。"
      },
      {
        "t": 4.93,
        "d": 4.936,
        "text": "会員は、8月の発表で、400万人あまり。件数は、それより、ずっと多い。"
      }
    ],
    "c103": [
      {
        "t": 0.0,
        "d": 3.721,
        "text": "漏えいの対象には、退会した人まで含まれていた。そして会社は、"
      },
      {
        "t": 4.211,
        "d": 3.671,
        "text": "運転免許証の画像を、退会してから7年間、持ち続けていた。"
      }
    ],
    "c104": [
      {
        "t": 0.0,
        "d": 1.856,
        "text": "退会したのに、なんで残ってたの？",
        "who": "q"
      },
      {
        "t": 2.346,
        "d": 3.411,
        "text": "会社は、自分たちで定めた基準のとおりに、持っていたとしている。"
      },
      {
        "t": 6.247,
        "d": 4.867,
        "text": "訴えを準備する弁護士は、法律との関係を、いま分かっている中で一番強い争点だとした。"
      }
    ],
    "c105": [
      {
        "t": 0.0,
        "d": 4.773,
        "text": "外へ送られた跡がある画像は、146万件あまり。見舞金は、3000円分。"
      },
      {
        "t": 5.263,
        "d": 3.438,
        "text": "訴えに加わりたい人は、弁護士側によると、10万人を超えた。"
      }
    ],
    "c106": [
      {
        "t": 0.0,
        "d": 4.808,
        "text": "攻撃したのが、だれなのか。10月31日の時点で、まだ明らかになっていない。"
      },
      {
        "t": 5.298,
        "d": 2.508,
        "text": "逮捕や、名乗り出たという報道も、見当たらない。"
      }
    ],
    "c107": [
      {
        "t": 0.0,
        "d": 1.426,
        "text": "いったい、何が起きていたの？",
        "who": "q"
      },
      {
        "t": 1.916,
        "d": 3.965,
        "text": "会社の発表と、国や報道の記録をもとに、最初の朝から順にたどる。"
      }
    ],
    "c201": [
      {
        "t": 0.0,
        "d": 2.708,
        "text": "気づいたその日のうちに、会社は最初の知らせを出した。"
      },
      {
        "t": 3.197,
        "d": 3.546,
        "text": "第三者がシステムに入った跡があり、情報が漏えいした可能性がある、"
      },
      {
        "t": 7.233,
        "d": 0.705,
        "text": "という中身だ。"
      }
    ],
    "c202": [
      {
        "t": 0.0,
        "d": 2.612,
        "text": "同じ日、会社は、問題のサーバーを切り離し、"
      },
      {
        "t": 3.102,
        "d": 1.55,
        "text": "入り込まれた道を、ふさいだ。"
      },
      {
        "t": 5.141,
        "d": 2.615,
        "text": "国の個人情報保護委員会にも、報告している。"
      }
    ],
    "c203": [
      {
        "t": 0.0,
        "d": 1.591,
        "text": "それで、完全に止められたの？",
        "who": "q"
      },
      {
        "t": 2.08,
        "d": 3.098,
        "text": "攻撃元との通信を断ち、もう入れないと確かめ終えたのは、"
      },
      {
        "t": 5.668,
        "d": 2.866,
        "text": "遅くとも、翌26日の午前7時25分だ。"
      }
    ],
    "c204": [
      {
        "t": 0.0,
        "d": 4.788,
        "text": "9月28日、2回目の知らせで、情報の一部が第三者に取られていたと発表した。"
      },
      {
        "t": 5.278,
        "d": 3.817,
        "text": "今の会員のほか、退会した人や、入会が済まなかった人の分もだ。"
      }
    ],
    "c205": [
      {
        "t": 0.0,
        "d": 3.832,
        "text": "同じ日、会社は警察に相談を始め、国土交通省にも知らせた。"
      },
      {
        "t": 4.322,
        "d": 2.85,
        "text": "親会社のパーク24 も、投資する人たちに向けた、"
      },
      {
        "t": 7.662,
        "d": 1.524,
        "text": "決まった形のお知らせを出した。"
      }
    ],
    "c206": [
      {
        "t": 0.0,
        "d": 2.025,
        "text": "翌29日の、3回目の知らせ。"
      },
      {
        "t": 2.514,
        "d": 2.169,
        "text": "入会のときに出した免許証などの画像が、"
      },
      {
        "t": 5.174,
        "d": 2.699,
        "text": "漏えいしたアカウントは、約160万件だとした。"
      }
    ],
    "c207": [
      {
        "t": 0.0,
        "d": 2.08,
        "text": "知らせのたびに、分かることが増えていくね。",
        "who": "q"
      },
      {
        "t": 2.57,
        "d": 2.873,
        "text": "そう。調べが進むごとに、中身が足されていった。"
      }
    ],
    "c208": [
      {
        "t": 0.0,
        "d": 2.908,
        "text": "10月1日には、退会した人への案内も始まった。"
      }
    ],
    "c209": [
      {
        "t": 0.0,
        "d": 4.926,
        "text": "会社の説明では、攻撃の入り口は、Webシステムにあった脆弱性だ。脆弱性とは、"
      },
      {
        "t": 5.416,
        "d": 2.739,
        "text": "プログラムの中の、攻撃に使われうる弱いところをいう。"
      }
    ],
    "c210": [
      {
        "t": 0.0,
        "d": 2.994,
        "text": "そこから入った者は、システムの中の情報を探し回り、"
      },
      {
        "t": 3.484,
        "d": 1.257,
        "text": "手に入れた情報を使って、"
      },
      {
        "t": 5.231,
        "d": 2.284,
        "text": "データベースと、ファイルの置き場にまで入り込んだ。"
      }
    ],
    "c211": [
      {
        "t": 0.0,
        "d": 2.413,
        "text": "どうやって入ったのか、詳しいことは分からないの？",
        "who": "q"
      },
      {
        "t": 2.903,
        "d": 2.728,
        "text": "攻撃のやり方の細かいところや、システムの作りは、"
      },
      {
        "t": 6.12,
        "d": 4.565,
        "text": "二次被害を防ぐためとして、会社は、10月23日の発表でも公表を控えた。"
      }
    ],
    "c212": [
      {
        "t": 0.0,
        "d": 3.924,
        "text": "いつから入られていたのかも、10月31日の時点で、明かされていない。"
      }
    ],
    "c214": [
      {
        "t": 0.0,
        "d": 3.43,
        "text": "会社は、気づいた日から、外部の専門機関に調べてもらっていた。"
      },
      {
        "t": 3.92,
        "d": 3.768,
        "text": "侵入の跡を調べる、コンピューターの鑑識だ。フォレンジック調査という。"
      }
    ],
    "c215": [
      {
        "t": 0.0,
        "d": 3.023,
        "text": "外部の専門の人たちが、侵入の跡を調べていたんだね。",
        "who": "q"
      },
      {
        "t": 3.513,
        "d": 2.191,
        "text": "そう。その調べには、気づいた日から、"
      },
      {
        "t": 6.195,
        "d": 1.251,
        "text": "ちょうど4週間かかった。"
      }
    ],
    "c216": [
      {
        "t": 0.0,
        "d": 4.061,
        "text": "9月29日の知らせでは、くわしい結果は2週間ほどをめどに、としていた。"
      },
      {
        "t": 4.551,
        "d": 3.358,
        "text": "それを、10月16日の知らせで、23日まで延ばした。"
      }
    ],
    "c217": [
      {
        "t": 0.0,
        "d": 2.962,
        "text": "そして10月23日、調べが終わり、数がそろう。"
      }
    ],
    "c301": [
      {
        "t": 0.0,
        "d": 3.389,
        "text": "会社が「最終」とした件数は、662万8007件。"
      },
      {
        "t": 3.879,
        "d": 2.724,
        "text": "これより広がったことは、確かめられていない、とした。"
      }
    ],
    "c302": [
      {
        "t": 0.0,
        "d": 4.598,
        "text": "名前、住所、生年月日、電話番号、メールアドレス、運転免許の情報。"
      },
      {
        "t": 5.088,
        "d": 3.009,
        "text": "どれも、アクセスされたうえ、外へ送られた跡が見つかった。"
      }
    ],
    "c303": [
      {
        "t": 0.0,
        "d": 1.872,
        "text": "「外へ送られた跡」って、どういうこと？",
        "who": "q"
      },
      {
        "t": 2.362,
        "d": 3.441,
        "text": "攻撃した者によって、データがシステムの外へ送り出された記録が、"
      },
      {
        "t": 6.293,
        "d": 1.4,
        "text": "残っていた、ということだ。"
      }
    ],
    "c304": [
      {
        "t": 0.0,
        "d": 3.6,
        "text": "662万件の中には、タイムズビジネスサービスから入会し、"
      },
      {
        "t": 4.09,
        "d": 2.292,
        "text": "駐車場だけをカード払いで契約した人もいる。"
      }
    ],
    "c305": [
      {
        "t": 0.0,
        "d": 4.733,
        "text": "9月の知らせでは、免許証などの画像が漏えいしたアカウントは、約160万件だった。"
      },
      {
        "t": 5.223,
        "d": 4.544,
        "text": "調べ直すと、外へ送られた跡がある画像は、146万4800件だった。"
      }
    ],
    "c306": [
      {
        "t": 0.0,
        "d": 2.878,
        "text": "アクセスはされたが、送られた跡は見つからなかった画像が、"
      },
      {
        "t": 3.368,
        "d": 4.78,
        "text": "89万件あまり。アクセスを受けた画像は、合わせて235万件あまりになる。"
      }
    ],
    "c307": [
      {
        "t": 0.0,
        "d": 2.571,
        "text": "じゃあ、免許証の画像が、そのまま見られちゃうの？",
        "who": "q"
      },
      {
        "t": 3.061,
        "d": 3.911,
        "text": "画像は、暗号化して保管していた、と会社は書いている。暗号化とは、"
      },
      {
        "t": 7.462,
        "d": 2.058,
        "text": "鍵が無いと読めない形に変えておくことだ。"
      }
    ],
    "c308": [
      {
        "t": 0.0,
        "d": 3.586,
        "text": "外へ送られた跡があるからといって、すぐに中身が見られる状態になった、"
      },
      {
        "t": 4.075,
        "d": 2.01,
        "text": "という意味ではない、と会社は説明する。"
      }
    ],
    "c309": [
      {
        "t": 0.0,
        "d": 1.185,
        "text": "ただ、こうも書いている。"
      },
      {
        "t": 1.675,
        "d": 3.649,
        "text": "この先、元の画像に戻される可能性は、完全には否定できない。"
      },
      {
        "t": 5.814,
        "d": 1.686,
        "text": "元に戻すことを、復号という。"
      }
    ],
    "c310": [
      {
        "t": 0.0,
        "d": 3.271,
        "text": "いますぐ見られるわけじゃないけど、この先は分からない、ってことね。",
        "who": "q"
      },
      {
        "t": 3.761,
        "d": 2.539,
        "text": "そう。会社自身が、その両方を書いている。"
      }
    ],
    "c311": [
      {
        "t": 0.0,
        "d": 1.293,
        "text": "もう1つの会員の仕組み、"
      },
      {
        "t": 1.783,
        "d": 1.461,
        "text": "タイムズクラブにも入られていた。"
      },
      {
        "t": 3.734,
        "d": 5.462,
        "text": "名前や免許の情報が5件、会員カードの番号が1万9510件、外へ送られた跡があった。"
      }
    ],
    "c312": [
      {
        "t": 0.0,
        "d": 3.764,
        "text": "会社は、クレジットカードの番号の全部の桁を、持たない仕組みにしていた。"
      },
      {
        "t": 4.253,
        "d": 4.213,
        "text": "漏えいしたのは、タイムズクラブ側の、番号の下4桁、28件だけだ。"
      }
    ],
    "c313": [
      {
        "t": 0.0,
        "d": 2.851,
        "text": "パスワードは、元に戻せない形に変えて保管していた。"
      },
      {
        "t": 3.341,
        "d": 2.293,
        "text": "外へ送られた跡があったのは、4件だった。"
      }
    ],
    "c314": [
      {
        "t": 0.0,
        "d": 0.969,
        "text": "直された数もある。"
      },
      {
        "t": 1.459,
        "d": 3.465,
        "text": "タイムズカーとつないでいた、JR西日本の会員サービスのIDは、"
      },
      {
        "t": 5.414,
        "d": 3.822,
        "text": "9月には漏えいの対象とされたが、10月の調べで、0件と分かった。"
      }
    ],
    "c315": [
      {
        "t": 0.0,
        "d": 2.64,
        "text": "最初に聞いた話より、ずいぶん詳しくなったんだね。",
        "who": "q"
      },
      {
        "t": 3.13,
        "d": 4.309,
        "text": "そう。最初の知らせの「可能性」が、4週間かけて、細かな数に変わった。"
      }
    ],
    "c316": [
      {
        "t": 0.0,
        "d": 3.325,
        "text": "漏えいした情報が、売り買いされたり、公開されたりした事実は、"
      },
      {
        "t": 3.815,
        "d": 4.209,
        "text": "会社が知る範囲では、10月23日の発表の時点で、確かめられていない。"
      }
    ],
    "c317": [
      {
        "t": 0.0,
        "d": 2.439,
        "text": "会社は、ふつうの方法では見られないネットの奥、"
      },
      {
        "t": 2.929,
        "d": 2.164,
        "text": "ダークウェブもふくめて、見張りを続けるという。"
      },
      {
        "t": 5.583,
        "d": 3.075,
        "text": "では、その662万件は、だれの情報なのか。"
      }
    ],
    "c401": [
      {
        "t": 0.0,
        "d": 4.383,
        "text": "2026年8月、会社は、会員が400万人を超えたと発表していた。"
      },
      {
        "t": 4.873,
        "d": 5.102,
        "text": "ところが、漏えいの件数は、662万件あまり。会員の数を、大きく上回る。"
      }
    ],
    "c402": [
      {
        "t": 0.0,
        "d": 1.614,
        "text": "どうして、会員より多くなるの？",
        "who": "q"
      },
      {
        "t": 2.104,
        "d": 3.448,
