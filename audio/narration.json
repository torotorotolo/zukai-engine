        "t": 0.0,
        "d": 4.745,
        "text": "求める慰謝料は、1人3万円。免許証などの画像が漏えいした人は、5万円だ。"
      },
      {
        "t": 5.235,
        "d": 1.736,
        "text": "見舞金より、ずっと高いんだね。",
        "who": "q"
      }
    ],
    "c611": [
      {
        "t": 0.0,
        "d": 3.487,
        "text": "ただ、10月31日の時点で、まだ訴えは起こされていない。"
      },
      {
        "t": 3.977,
        "d": 3.287,
        "text": "加わりたい人は、会見の時点で、10万人を超えていたという。"
      },
      {
        "t": 7.754,
        "d": 3.093,
        "text": "弁護士は、気持ちとしては年内に訴えたい、と話している。"
      }
    ],
    "c612": [
      {
        "t": 0.0,
        "d": 1.973,
        "text": "会見で、弁護士は、こう話した。"
      },
      {
        "t": 2.463,
        "d": 3.208,
        "text": "「3000円という金額を見たとき、非常に低すぎるのではないか」"
      }
    ],
    "c613": [
      {
        "t": 0.0,
        "d": 2.32,
        "text": "でも、会社も、攻撃された側じゃないの？",
        "who": "q"
      },
      {
        "t": 2.81,
        "d": 1.626,
        "text": "その見方について、弁護士は、"
      },
      {
        "t": 4.926,
        "d": 2.253,
        "text": "「被害者かつ加害者ということはあり得る」と話した。"
      }
    ],
    "c614": [
      {
        "t": 0.0,
        "d": 3.219,
        "text": "弁護士のもとには、「勝手にローンを組まれた」という相談も寄せられた、"
      },
      {
        "t": 3.709,
        "d": 4.58,
        "text": "と報じられた。漏えいとの関係は、10月31日の時点で、分かっていない。"
      },
      {
        "t": 8.778,
        "d": 4.019,
        "text": "会社は、知る範囲では、売り買いや公開の事実は確かめられていない、とした。"
      }
    ],
    "c615": [
      {
        "t": 0.0,
        "d": 2.378,
        "text": "毎日新聞によると、30代の男性は、"
      },
      {
        "t": 2.869,
        "d": 2.199,
        "text": "「3000円では不安も不満も消えない」と語った。"
      },
      {
        "t": 5.558,
        "d": 1.56,
        "text": "不満の声も、出ているんだね。",
        "who": "q"
      }
    ],
    "c616": [
      {
        "t": 0.0,
        "d": 0.93,
        "text": "SNS上では、"
      },
      {
        "t": 1.42,
        "d": 3.884,
        "text": "「免許証の画像７年保管してたのも、本当おかしいし」という声が挙がっている。"
      }
    ],
    "c617": [
      {
        "t": 0.0,
        "d": 1.627,
        "text": "一方で、会社の知らせ方を、"
      },
      {
        "t": 2.117,
        "d": 2.601,
        "text": "「ここはしっかり対応してるのでそこは素晴らしい」とほめつつ、"
      },
      {
        "t": 5.208,
        "d": 2.62,
        "text": "集団訴訟のサイトにも申し込んだ、という声もある。"
      }
    ],
    "c618": [
      {
        "t": 0.0,
        "d": 3.246,
        "text": "「タイムズカーじゃなくて、ハッカーたちが犯人だよね？」という声。"
      },
      {
        "t": 3.736,
        "d": 1.542,
        "text": "「非難されても仕方ない」としつつ、"
      },
      {
        "t": 5.768,
        "d": 3.839,
        "text": "「その後の犯罪の責任まで負わせる必要はあるのでしょうか？」と問う声もある。"
      }
    ],
    "c619": [
      {
        "t": 0.0,
        "d": 2.055,
        "text": "責める声も、かばう声も、あるんだね。",
        "who": "q"
      },
      {
        "t": 2.545,
        "d": 3.307,
        "text": "そう。会社の責任をどこまで問えるのかは、訴えが起これば、"
      },
      {
        "t": 6.342,
        "d": 0.973,
        "text": "裁判で争われる。"
      }
    ],
    "c620": [
      {
        "t": 0.0,
        "d": 4.274,
        "text": "会社は、社外取締役を中心に、外部の専門家も加えた調査委員会で、"
      },
      {
        "t": 4.764,
        "d": 3.739,
        "text": "管理の仕組みを確かめるとした。強化策は、年内をめどに出すという。"
      }
    ],
    "c701": [
      {
        "t": 0.0,
        "d": 4.744,
        "text": "では、いま、できることは何か。会社は、専用の窓口を24時間開いている。"
      },
      {
        "t": 5.234,
        "d": 3.192,
        "text": "電話番号と問い合わせのフォームは、画面と説明欄に書いておく。"
      }
    ],
    "c702": [
      {
        "t": 0.0,
        "d": 2.221,
        "text": "自分が対象かどうかは、どうやって分かるの？",
        "who": "q"
      },
      {
        "t": 2.712,
        "d": 3.075,
        "text": "会員は、10月23日の夕方から、マイページで、"
      },
      {
        "t": 6.277,
        "d": 3.96,
        "text": "自分のどの情報が漏えいしたかを見られる。退会した人は、フォームで聞ける。"
      }
    ],
    "c703": [
      {
        "t": 0.0,
        "d": 2.955,
        "text": "会社や、公的な機関を名乗る連絡には、気をつけたい。"
      },
      {
        "t": 3.445,
        "d": 3.724,
        "text": "会社は、SMSの認証コードや、パスワード、暗証番号などを、"
      },
      {
        "t": 7.659,
        "d": 1.342,
        "text": "聞くことはない、としている。"
      }
    ],
    "c704": [
      {
        "t": 0.0,
        "d": 2.373,
        "text": "会社は、この件を警察庁に相談している。"
      },
      {
        "t": 2.863,
        "d": 3.73,
        "text": "警察庁も、警察を名乗ってだます、ニセ警察詐欺に気をつけるよう、"
      },
      {
        "t": 7.083,
        "d": 0.719,
        "text": "呼びかけている。"
      }
    ],
    "c705": [
      {
        "t": 0.0,
        "d": 3.537,
        "text": "10月31日の時点で、攻撃した者は明らかになっていない。"
      },
      {
        "t": 4.027,
        "d": 2.808,
        "text": "預けた情報は、いつまで残るのか。その問いは、"
      },
      {
        "t": 7.325,
        "d": 1.536,
        "text": "1つの会社だけのものではない。"
      }
    ],
    "c706": [
      {
        "t": 0.0,
        "d": 3.771,
        "text": "あなたは、退会したサービスに、自分の情報が残っているかもしれないと、"
      },
      {
        "t": 4.261,
        "d": 3.329,
        "text": "考えたことはありますか。よければ、コメントで教えてください。"
      }
    ],
    "ed01": [
      {
        "t": 0.0,
        "d": 1.349,
        "text": "ご視聴ありがとうございました。"
      },
      {
        "t": 1.839,
        "d": 2.274,
        "text": "この動画が少しでも気に入れば、高評価と"
      },
      {
        "t": 4.603,
        "d": 1.476,
        "text": "チャンネル登録をお願いします。"
      }
    ]
  },
